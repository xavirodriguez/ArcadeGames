{
  "path": [
    "packages/core/src",
    "src/games"
  ],
  "pattern": "**/*.ts",
  "ignore": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/mocks/**",
    "**/dist/**",
    "**/compiled-js/**",
    "**/node_modules/**"
  ],
  "ignorePattern": [
    "import\\s+[\\s\\S]*?\\s+from\\s+['\"].*?['\"];?",
    "export\\s+[\\s\\S]*?\\s+from\\s+['\"].*?['\"];?"
  ],
  "threshold": 1.5,
  "format": [
    "typescript"
  ],
  "reporters": [
    "console",
    "json",
    "markdown"
  ],
  "absolute": false
}

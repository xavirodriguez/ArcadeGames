{
  "path": [
    "packages/core/src",
    "src"
  ],
  "pattern": "**/*.ts",
  "ignore": [
    "**/*.test.ts",
    "**/__tests__/**",
    "**/dist/**",
    "**/compiled-js/**",
    "**/node_modules/**"
  ],
  "format": [
    "typescript"
  ],
  "reporters": [
    "json",
    "console"
  ],
  "output": "./report",
  "absolute": false
}

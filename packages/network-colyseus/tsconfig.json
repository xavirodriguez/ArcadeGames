{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist", // STOP CONTAMINATION: Output directory configured to "./dist" for compiled artifacts
        "composite": false,
        "incremental": false,
        "skipLibCheck": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@tiny-aster/core": ["../core/src/index.ts"],
            "@tiny-aster/network": ["../network/src/index.ts"]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}

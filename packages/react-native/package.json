{
  "name": "@tiny-aster/react-native",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "pnpm exec tsup",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "clean:artifacts": "[ -d src ] && find src -type f \\( -name \"*.js\" -o -name \"*.js.map\" \\) -delete || true"
  },
  "dependencies": {
    "@tiny-aster/core": "workspace:*",
    "@tiny-aster/network-colyseus": "workspace:*"
  },
  "peerDependencies": {
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-keep-awake": "~55.0.8",
    "react": ">=18",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-keep-awake": "~55.0.8",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}

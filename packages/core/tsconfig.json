{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": [
            "ESNext",
            "dom"
        ],
        "strict": true,
        "declaration": true,
        "sourceMap": true,
        "outDir": "./dist", // STOP CONTAMINATION: Output directory configured to "./dist" for compiled artifacts
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@tiny-aster/core": ["./src/index.ts"],
            "@tiny-aster/core/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts"
    ]
}
